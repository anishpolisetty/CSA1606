# Input array
arr = [25, 10, 45, 30, 15]

n = len(arr)

# Bubble Sort in descending order
for i in range(n - 1):
    for j in range(n - i - 1):
        if arr[j] < arr[j + 1]:
            arr[j], arr[j + 1] = arr[j + 1], arr[j]

# Display sorted array
print("Sorted Array:")

for num in arr:
    print(num, end=" ")
