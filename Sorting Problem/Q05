# Input array
arr = [7, 10, 4, 3, 20, 15]

# Value of k
k = 3

# Selection Sort
n = len(arr)

for i in range(n - 1):
    min_index = i

    for j in range(i + 1, n):
        if arr[j] < arr[min_index]:
            min_index = j

    # Swap
    arr[i], arr[min_index] = arr[min_index], arr[i]

# Display kth smallest element
print(f"{k}rd Smallest Element = {arr[k - 1]}")
