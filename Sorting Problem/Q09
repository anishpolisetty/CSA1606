# Input array
arr = [9, 7, 5, 3, 1]

n = len(arr)
passes = 0

# Bubble Sort
for i in range(n - 1):
    passes += 1

    for j in range(n - i - 1):
        if arr[j] > arr[j + 1]:
            arr[j], arr[j + 1] = arr[j + 1], arr[j]

# Display sorted array
print("Sorted Array:")
for num in arr:
    print(num, end=" ")

print("\nPasses required:", passes)
