# Input names
names = ["Ram", "Arun", "Kiran", "Bala"]

n = len(names)

# Bubble Sort
for i in range(n - 1):
    for j in range(n - i - 1):
        if names[j] > names[j + 1]:
            names[j], names[j + 1] = names[j + 1], names[j]

# Display sorted names
print("Sorted Names:")

for name in names:
    print(name)
